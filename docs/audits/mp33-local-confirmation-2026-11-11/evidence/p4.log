
## P4 the deployer's home (by hand; EP-248 issues it from a bundle) and its refusals
export NAGARE_INVENTORY_STORE='object'
export NAGARE_INVENTORY_STORE_URL='http://minio.nagare-system.svc.cluster.local:9000/nagare-inventory/mp33'
export NAGARE_DEPLOYER=ci
$ CI inventory status --scope application:op-hello
