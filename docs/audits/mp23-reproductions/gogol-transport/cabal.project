packages: .

-- Current upstream main; master still names the historical 0.5.0 release.
-- mori://brendanhay/gogol/repos/gogol
source-repository-package
  type: git
  location: https://github.com/brendanhay/gogol
  tag: 881cd14c9844131b4a8d96ca1bbb2bd9a2409ed9
  subdir:
    lib/gogol
    lib/gogol-core
    lib/services/gogol-storage

-- Test against Nagare's existing direct dependencies, without downgrading them.
-- These are scoped compatibility experiments, not a blanket bound relaxation.
allow-newer: gogol:aeson, gogol:crypton, gogol:crypton-x509, gogol:crypton-x509-store, gogol-core:aeson
constraints: aeson ==2.3.2.0, crypton ==1.1.5, crypton-x509 ==1.9.1, crypton-x509-store ==1.9.0
