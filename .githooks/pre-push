#!/usr/bin/env bash
# EP-174: refuse a push of any commit that is not landable (a green fast or
# full record, or one carried forward over inert documentation; `just
# gate-landable`). Installed with `just install-hooks`. The hook never runs a
# gate itself, so an accidental `git push` fails at once instead of starting a
# fast gate under the operator's work; gate with `just gate-fast` and push
# with `just land`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin;
# the record is checked for each pushed commit, not for the working tree, so
# `just land` can push a gated commit from any checkout.
ungated=()
while read -r _ local_sha _ _; do
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue
  just gate-landable "$local_sha" >/dev/null 2>&1 || ungated+=("$local_sha")
done
if [ "${#ungated[@]}" -eq 0 ]; then
  echo "pre-push: every pushed commit is landable"
  exit 0
fi
echo "pre-push: not landable: ${ungated[*]}; push refused. Run just gate-fast, then just land." >&2
exit 1
