apiVersion: apps/v1
kind: Deployment
metadata:
  name: nix-cache
  namespace: nagare-system
  labels: {app.kubernetes.io/name: nix-cache, app.kubernetes.io/part-of: nagare}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: nix-cache}
  template:
    metadata:
      labels: {app.kubernetes.io/name: nix-cache, app.kubernetes.io/part-of: nagare}
      annotations:
        nagare.dev/nix-cache-config-sha256: "${ATTIC_CONFIG_SHA256}"
    spec:
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: attic
          image: ${ATTIC_IMAGE}
          args: ["-f", "/config/server.toml", "--mode", "api-server"]
          ports: [{name: http, containerPort: 8080}]
          env:
            - {name: ATTIC_SERVER_DATABASE_URL, valueFrom: {secretKeyRef: {name: nagare-db-nix-cache, key: DATABASE_URL}}}
            - {name: AWS_ACCESS_KEY_ID, valueFrom: {secretKeyRef: {name: nagare-nix-cache-storage, key: AWS_ACCESS_KEY_ID}}}
            - {name: AWS_SECRET_ACCESS_KEY, valueFrom: {secretKeyRef: {name: nagare-nix-cache-storage, key: AWS_SECRET_ACCESS_KEY}}}
            - {name: ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64, valueFrom: {secretKeyRef: {name: nagare-nix-cache-token-key, key: ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64}}}
          resources:
            requests: {cpu: 250m, memory: 256Mi}
            limits: {cpu: "1", memory: 1Gi}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: tmp, mountPath: /tmp}
          readinessProbe:
            httpGet:
              path: /
              port: http
              httpHeaders: [{name: Host, value: nix-cache.nagare-system.svc.cluster.local}]
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /
              port: http
              httpHeaders: [{name: Host, value: nix-cache.nagare-system.svc.cluster.local}]
            initialDelaySeconds: 10
            periodSeconds: 10
      volumes:
        - {name: config, configMap: {name: nagare-nix-cache-server}}
        - {name: tmp, emptyDir: {}}
---
apiVersion: v1
kind: Service
metadata:
  name: nix-cache
  namespace: nagare-system
  labels: {app.kubernetes.io/name: nix-cache, app.kubernetes.io/part-of: nagare}
spec:
  selector: {app.kubernetes.io/name: nix-cache}
  ports: [{name: http, port: 80, targetPort: http}]
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nix-cache-gc
  namespace: nagare-system
  labels: {app.kubernetes.io/name: nix-cache, app.kubernetes.io/part-of: nagare}
spec:
  schedule: "17 4 * * *"
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 1800
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 3600
      template:
        metadata:
          labels: {app.kubernetes.io/name: nix-cache, app.kubernetes.io/part-of: nagare}
        spec:
          restartPolicy: Never
          automountServiceAccountToken: false
          securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, seccompProfile: {type: RuntimeDefault}}
          containers:
            - name: attic
              image: ${ATTIC_IMAGE}
              args: ["-f", "/config/server.toml", "--mode", "garbage-collector-once"]
              env:
                - {name: ATTIC_SERVER_DATABASE_URL, valueFrom: {secretKeyRef: {name: nagare-db-nix-cache, key: DATABASE_URL}}}
                - {name: AWS_ACCESS_KEY_ID, valueFrom: {secretKeyRef: {name: nagare-nix-cache-storage, key: AWS_ACCESS_KEY_ID}}}
                - {name: AWS_SECRET_ACCESS_KEY, valueFrom: {secretKeyRef: {name: nagare-nix-cache-storage, key: AWS_SECRET_ACCESS_KEY}}}
                - {name: ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64, valueFrom: {secretKeyRef: {name: nagare-nix-cache-token-key, key: ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64}}}
              securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
              volumeMounts:
                - {name: config, mountPath: /config, readOnly: true}
                - {name: tmp, mountPath: /tmp}
          volumes:
            - {name: config, configMap: {name: nagare-nix-cache-server}}
            - {name: tmp, emptyDir: {}}
