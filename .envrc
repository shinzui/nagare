# Resolve and export the active target context (EP-89). This shared resolver
# honors NAGARE_CONTEXT > current-context pointer > in-repo profile > default,
# applies env > context > default per field, and exports CLOUDSDK_* + NAGARE_*.
source "$PWD/scripts/lib/target.sh"

if [ -n "${XDG_CONFIG_HOME:-}" ]; then
  _nagare_cfg="${XDG_CONFIG_HOME}/nagare"
elif [ -n "${HOME:-}" ]; then
  _nagare_cfg="${HOME}/.config/nagare"
else
  _nagare_cfg=".config/nagare"
fi
watch_file "${_nagare_cfg}/current-context"
[ -n "${NAGARE_ACTIVE_CONTEXT_FILE:-}" ] && watch_file "${NAGARE_ACTIVE_CONTEXT_FILE}"
[ -f "$PWD/nagare.target.env" ] && watch_file "$PWD/nagare.target.env"
[ -f "$PWD/nagare.local.env" ] && watch_file "$PWD/nagare.local.env"

# Pulumi secrets use the passphrase provider, initialised with an empty
# passphrase. Export it explicitly so `pulumi config set --secret` and
# `pulumi up` don't prompt or error. To tighten later, run
# `pulumi stack change-secrets-provider passphrase` with a real value and
# update this line.
export PULUMI_CONFIG_PASSPHRASE=""

# Project-pinned Pulumi + Haskell + cloud toolchain (see flake.nix).
# `use flake` loads devShells.<system>.default onto PATH so pulumi, node,
# tsc, gcloud, kubectl, helm, ghc, cabal, sops, etc. come from the flake
# rather than any global install.
use flake

# EP-90: Pulumi state and config projection are selected per active target
# context. scripts/lib/target.sh exports PULUMI_HOME/PULUMI_BACKEND_URL under
# ${XDG_STATE_HOME:-$HOME/.local/state}/nagare/$NAGARE_CONTEXT and selects (or
# initializes) the Pulumi stack whose name is the context name. No pulumi login
# step is required; PULUMI_BACKEND_URL selects the file backend.
#
# EP-93: for a gcs backend, skip the eager stack select — it would hit GCS
# (credentials + network) on every `direnv reload`. nagarectl selects/initialises
# the stack against GCS when it needs it.
if [ "${NAGARE_PULUMI_BACKEND:-local}" != "gcs" ]; then
  _nagare_select_pulumi_stack
fi
