cabal-version: 3.0
name: nagare-harness
version: 0.1.0
synopsis: Local gate and acceptance harness for Nagare candidates.
description:
  nagare-harness runs Nagare's local gates (EP-174) and, later, the scripted
  local acceptance run (EP-168). It is maintainer tooling outside the
  platform payload.

build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wno-unused-imports
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -threaded

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Nagare.Harness.CarryForward
    Nagare.Harness.FixtureSmoke
    Nagare.Harness.Gate
    Nagare.Harness.Mutation
    Nagare.Harness.Prelude
    Nagare.Harness.Realise
    Nagare.Harness.Record
    Nagare.Harness.Step
    Nagare.Harness.Verify

  build-depends:
    aeson,
    aeson-pretty,
    base >=4.17 && <5,
    bytestring,
    containers,
    directory >=1.3.7,
    filepath,
    generic-lens ^>=2.3,
    lens ^>=5.3,
    process,
    random >=1.2,
    text,
    time,
    transformers,
    vector,

executable nagare-harness
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    filepath,
    generic-lens ^>=2.3,
    lens ^>=5.3,
    nagare-harness,
    optparse-applicative,
    text,

test-suite nagare-harness-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    aeson,
    base,
    containers,
    directory,
    filepath,
    generic-lens ^>=2.3,
    lens ^>=5.3,
    nagare-harness,
    process,
    tasty >=1.4,
    tasty-hunit >=0.10,
    temporary,
    text,
