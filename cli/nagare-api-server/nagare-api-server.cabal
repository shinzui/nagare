cabal-version: 3.0
name: nagare-api-server
-- Constant: the release version is written only in release.json (EP-210).
version: 0.0.0
synopsis: Nagare's read-only admin API server.
description:
  Serves one context's recorded inventory state through the routes of
  nagare-api, reading the inventory store through the nagarectl library's
  recorded-state reader.

build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wno-unused-imports
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -Werror=missing-fields
    -threaded

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Nagare.Api.Access.Handler
    Nagare.Api.Inventory.Handler
    Nagare.Api.Platform.Handler
    Nagare.Api.Server.App
    Nagare.Api.Server.Pagination
    Nagare.Api.Server.Problems
    Nagare.Api.Server.RequestLog
    Nagare.Api.Server.Serve
    Nagare.Api.Server.Validators
    Nagare.Api.Sites.Handler

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.17 && <5,
    bytestring,
    containers,
    generic-lens ^>=2.3,
    http-types,
    lens ^>=5.3,
    nagare-api,
    nagare-contract,
    nagare-dsl,
    nagarectl,
    relay-pagination >=0.1.1.2 && <0.2,
    servant >=0.20.3 && <0.21,
    servant-health >=0.1 && <0.2,
    servant-server >=0.20.3 && <0.21,
    text,
    time,
    wai,

executable nagare-api-server
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    bytestring,
    generic-lens ^>=2.3,
    nagare-api-server,
    nagare-contract,
    nagare-dsl,
    nagarectl,
    optparse-applicative,
    text,
    warp,

test-suite nagare-api-server-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Nagare.Api.Server.Test.Client
    Nagare.Api.Server.Test.Document
    Nagare.Api.Server.Test.Fixture
    Nagare.Api.Server.Test.Serve

  build-depends:
    aeson,
    async,
    base,
    bytestring,
    containers,
    filepath,
    generic-lens ^>=2.3,
    http-client,
    http-media,
    http-types,
    lens,
    nagare-api,
    nagare-api-server,
    nagare-contract,
    nagare-dsl,
    nagarectl,
    openapi-hs,
    relay-pagination,
    relay-pagination-conformance >=0.1.1.2 && <0.2,
    servant,
    servant-client >=0.20.3 && <0.21,
    servant-client-core >=0.20.3 && <0.21,
    servant-health,
    servant-server >=0.20.3 && <0.21,
    tasty >=1.4,
    tasty-hunit >=0.10,
    temporary,
    text,
    time,
    warp,
