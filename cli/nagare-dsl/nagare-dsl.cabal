cabal-version: 3.0
name: nagare-dsl
version: 0.4.0
synopsis: Typed deployment model and Knative renderer for Nagare.
description:
  A library of maximally-safe Haskell types for describing Nagare
  deployments, together with a renderer that produces Knative Service and
  DomainMapping YAML. Illegal configurations (bad DNS names, value+secretRef
  env vars, max<min scale) are made unrepresentable by the type system.

build-type: Simple

-- House standard: GHC2024 + the common extension set (haskell-jitsurei).
common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wno-unused-imports

library
  import: common
  hs-source-dirs: src
  other-modules:
    Nagare.Dsl.Batch.Render
    Nagare.Dsl.Load.Application
    Nagare.Dsl.Load.Broker
    Nagare.Dsl.Load.Cdn
    Nagare.Dsl.Load.Database
    Nagare.Dsl.Load.Deployment
    Nagare.Dsl.Load.Error
    Nagare.Dsl.Load.Fields
    Nagare.Dsl.Load.File
    Nagare.Dsl.Load.Job
    Nagare.Dsl.Load.Process
    Nagare.Dsl.Load.ServerSite
    Nagare.Dsl.Load.Site
    Nagare.Dsl.Load.StaticSite
    Nagare.Dsl.Load.Task
    Nagare.Dsl.Load.Worker

  exposed-modules:
    Nagare.Dsl.Access
    Nagare.Dsl.Application
    Nagare.Dsl.Broker
    Nagare.Dsl.Broker.Render
    Nagare.Dsl.Broker.Types
    Nagare.Dsl.Build
    Nagare.Dsl.Cdn.Types
    Nagare.Dsl.Command
    Nagare.Dsl.Config
    Nagare.Dsl.Database
    Nagare.Dsl.Database.Render
    Nagare.Dsl.Image
    Nagare.Dsl.Job
    Nagare.Dsl.Job.Render
    Nagare.Dsl.Load
    Nagare.Dsl.Path
    Nagare.Dsl.Prelude
    Nagare.Dsl.Presets
    Nagare.Dsl.Render
    Nagare.Dsl.Server.Render
    Nagare.Dsl.Server.Types
    Nagare.Dsl.Static.Render
    Nagare.Dsl.Static.Types
    Nagare.Dsl.Task
    Nagare.Dsl.Task.Render
    Nagare.Dsl.Types
    Nagare.Dsl.Worker
    Nagare.Dsl.Worker.Render
    Nagare.Resource.Application
    Nagare.Resource.Broker
    Nagare.Resource.Cache
    Nagare.Resource.CacheClient
    Nagare.Resource.CacheKubernetes
    Nagare.Resource.Canonical
    Nagare.Resource.Cdn
    Nagare.Resource.Compile
    Nagare.Resource.Database
    Nagare.Resource.Helm
    Nagare.Resource.Inventory
    Nagare.Resource.Kubernetes
    Nagare.Resource.Policy
    Nagare.Resource.Reference
    Nagare.Resource.Types
    Nagare.Resource.Wire

  build-depends:
    aeson,
    base >=4.17 && <5,
    bytestring,
    containers,
    crypton >=1.0.6 && <1.2,
    directory,
    filepath,
    generic-lens ^>=2.3,
    lens ^>=5.3,
    process,
    text,
    yaml,

-- Tiny demo: prints renderLoadError of each LoadError variant (EP-10 M1.5).
executable nagare-dsl-load-demo
  import: common
  main-is: LoadDemo.hs
  hs-source-dirs: demo
  build-depends:
    base,
    nagare-dsl,
    text,

test-suite nagare-dsl-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
    ApplicationSpec
    CdnSpec
    JobSpec
    LoadSpec
    ResourceInventorySpec
    ServerSpec
    StaticSpec
    WorkerSpec

  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    generic-lens ^>=2.3,
    lens ^>=5.3,
    nagare-dsl,
    tasty >=1.4,
    tasty-golden >=2.3,
    tasty-hunit >=0.10,
    tasty-quickcheck >=0.10,
    temporary,
    text,
    yaml,
