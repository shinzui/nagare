cabal-version:   3.0
name:            nagare-dsl
version:         0.1.0.0
synopsis:        Typed deployment model and Knative renderer for Nagare.
description:
  A library of maximally-safe Haskell types for describing Nagare
  deployments, together with a renderer that produces Knative Service and
  DomainMapping YAML. Illegal configurations (bad DNS names, value+secretRef
  env vars, max<min scale) are made unrepresentable by the type system.

build-type:      Simple

-- House standard: GHC2024 + the common extension set (haskell-jitsurei).
common common
  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

  ghc-options:        -Wall -Wno-unused-imports

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Nagare.Dsl.Build
    Nagare.Dsl.Config
    Nagare.Dsl.Database
    Nagare.Dsl.Database.Render
    Nagare.Dsl.Load
    Nagare.Dsl.Path
    Nagare.Dsl.Prelude
    Nagare.Dsl.Presets
    Nagare.Dsl.Render
    Nagare.Dsl.Server.Render
    Nagare.Dsl.Server.Types
    Nagare.Dsl.Static.Render
    Nagare.Dsl.Static.Types
    Nagare.Dsl.Task
    Nagare.Dsl.Task.Render
    Nagare.Dsl.Types

  build-depends:
    , aeson
    , base          >=4.17 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , generic-lens  ^>=2.2
    , lens          ^>=5.3
    , process
    , text
    , yaml

-- Tiny demo: prints renderLoadError of each LoadError variant (EP-10 M1.5).
executable nagare-dsl-load-demo
  import:          common
  main-is:         LoadDemo.hs
  hs-source-dirs:  demo
  build-depends:
    , base
    , nagare-dsl
    , text

test-suite nagare-dsl-test
  import:          common
  type:            exitcode-stdio-1.0
  main-is:         Spec.hs
  hs-source-dirs:  test
  other-modules:
    LoadSpec
    ServerSpec
    StaticSpec
  build-depends:
    , base
    , bytestring
    , containers
    , nagare-dsl
    , tasty            >=1.4
    , tasty-golden     >=2.3
    , tasty-hunit      >=0.10
    , tasty-quickcheck >=0.10
    , temporary
    , text
