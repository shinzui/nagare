-- cli/nagarectl/cabal.project
--
-- Tells cabal where to find the nagarectl executable package and its local
-- sibling library nagare-dsl. The ../nagare-dsl entry makes the nagare-dsl
-- Cabal package available without publishing it to Hackage.
--
-- `cradle` is not on Hackage, so it is fetched directly from its upstream
-- repository (garnix-io/cradle) via the source-repository-package stanza below.
-- All other dependencies (optparse-applicative, text, bytestring, time,
-- temporary, lens, generic-lens, directory) resolve from Hackage.
--
-- `write-ghc-environment-files: always` materialises a `.ghc.environment.*`
-- here so that the loader's `runghc` (EP-10's Nagare.Dsl.Load) can resolve the
-- `nagare-dsl` package and its deps. As of EP-6 (MasterPlan 13), `nagarectl`
-- AUTO-DISCOVERS this file (see Nagare.GhcEnv.resolveProjectGhcEnv) when run from
-- an app directory, so no `--ghc-env` is needed in the normal case. The
-- `--ghc-env` flag and NAGARE_GHC_ENVIRONMENT remain as explicit overrides.
write-ghc-environment-files: always

packages:
  .
  ../nagare-dsl

source-repository-package
  type: git
  location: https://github.com/garnix-io/cradle
  tag: 711c441fa8f190a8964c56a3bae864cd5321c5c5
