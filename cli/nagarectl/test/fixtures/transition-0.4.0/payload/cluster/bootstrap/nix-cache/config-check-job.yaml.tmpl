apiVersion: batch/v1
kind: Job
metadata:
  name: nix-cache-config-check
  namespace: nagare-system
  labels: {app.kubernetes.io/name: nix-cache, app.kubernetes.io/part-of: nagare}
spec:
  backoffLimit: 0
  template:
    metadata:
      labels: {app.kubernetes.io/name: nix-cache, app.kubernetes.io/part-of: nagare}
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: attic
          image: ${ATTIC_IMAGE}
          args: ["-f", "/config/server.toml", "--mode", "check-config"]
          env:
            - {name: ATTIC_SERVER_DATABASE_URL, valueFrom: {secretKeyRef: {name: nagare-db-nix-cache-db, key: DATABASE_URL}}}
            - {name: AWS_ACCESS_KEY_ID, valueFrom: {secretKeyRef: {name: nagare-nix-cache-storage, key: AWS_ACCESS_KEY_ID}}}
            - {name: AWS_SECRET_ACCESS_KEY, valueFrom: {secretKeyRef: {name: nagare-nix-cache-storage, key: AWS_SECRET_ACCESS_KEY}}}
            - {name: ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64, valueFrom: {secretKeyRef: {name: nagare-nix-cache-token-key, key: ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64}}}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: ["ALL"]}}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: config, configMap: {name: nagare-nix-cache-server}}
        - {name: tmp, emptyDir: {}}
