apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-dns
spec:
  acme:
    # The ACME directory endpoint and contact come from the active target
    # context (NAGARE_ACME_DIRECTORY / NAGARE_ACME_EMAIL); there is no default
    # contact, and rendering this file refuses without one. Select Let's
    # Encrypt's staging service — untrusted certificates, much looser rate
    # limits — for a context with:
    #   nagarectl context create <name> --acme-directory staging
    server: ${NAGARE_ACME_DIRECTORY_URL}
    email: ${NAGARE_ACME_EMAIL}
    privateKeySecretRef:
      name: letsencrypt-dns-account-key
    solvers:
      - dns01:
          cloudDNS:
            # GCP project that owns the Cloud DNS managed zone (from EP-2).
            project: ${CLOUDSDK_CORE_PROJECT}
            # No serviceAccountSecretRef: use the VM's ambient Application
            # Default Credentials (the attached service account holds
            # roles/dns.admin, granted by EP-2). GKE Workload Identity does
            # not exist on self-managed k3s, so ambient creds are the
            # mechanism here.
