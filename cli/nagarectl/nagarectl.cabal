  build-depends:
    aeson,
    base >=4.17 && <5,
    bytestring,
    containers,
    cradle,
    crypton,
    directory,
    filepath,
    generic-lens ^>=2.3,
    http-client,
    http-client-tls,
    http-types,
    lens ^>=5.3,
    memory,
    nagare-dsl,
    process,
    temporary,
    text,
    time,
    unix,
    vector,
    yaml,

executable nagarectl
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    generic-lens ^>=2.3,
    lens ^>=5.3,
    nagare-dsl,
    nagarectl,
    optparse-applicative,
    process,
    temporary,
    text,
    time,
    unix,

