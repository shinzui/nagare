cabal-version: 3.0
name: nagarectl
version: 0.1.0.0
synopsis: Deploy a typed-config Nagare app to Knative with one command.
description:
  nagarectl is the Nagare deploy CLI. It loads a typed configuration file
  (the config-as-program substrate, via EP-10's Nagare.Dsl.Load), renders a
  Knative Service manifest with the nagare-dsl library (EP-9), builds and
  pushes a container image, applies the manifest, waits for readiness, and
  prints the live URL. The YAML-era nagare.yaml path is fully removed.

build-type: Simple

-- House standard: GHC2024 + the common extension set (haskell-jitsurei),
-- matching nagare-dsl.
common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wno-unused-imports
    -threaded

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Nagare.App
    Nagare.App.Deploy
    Nagare.App.Deployments
    Nagare.Build
    Nagare.Cdn.Cloudflare
    Nagare.Cdn.Provision
    Nagare.Cdn.Status
    Nagare.Cluster.GcsJob
    Nagare.Database.Backup
    Nagare.Database.Connection
    Nagare.Database.Create
    Nagare.Database.Delete
    Nagare.Database.Restore
    Nagare.Database.Discover
    Nagare.Database.Get
    Nagare.Database.List
    Nagare.Database.Restart
    Nagare.Database.Secret
    Nagare.Database.Shell
    Nagare.Deploy
    Nagare.Deploy.Resolve
    Nagare.Env.BuildArgs
    Nagare.Env.Dotenv
    Nagare.Env.Generated
    Nagare.Env.PreviewOverlay
    Nagare.Env.Store
    Nagare.GhcEnv
    Nagare.Image
    Nagare.Init
    Nagare.Ops.Cleanup
    Nagare.Ops.Doctor
    Nagare.Ops.Domains
    Nagare.Ops.Probe
    Nagare.Ops.Pulumi
    Nagare.Ops.Status
    Nagare.Server.Build
    Nagare.Server.Deploy
    Nagare.Server.Image
    Nagare.Static.Build
    Nagare.Static.Checkout
    Nagare.Static.Deploy
    Nagare.Static.Image
    Nagare.Static.Preview
    Nagare.Static.Release
    Nagare.Static.Webhook
    Nagare.Storage.Discover
    Nagare.Storage.Inspect
    Nagare.Storage.List
    Nagare.Storage.Restore
    Nagare.Storage.Snapshot
    Nagare.Target
    Nagare.Task.Delete
    Nagare.Task.Discover
    Nagare.Task.List
    Nagare.Task.Logs
    Nagare.Task.Resolve
    Nagare.Task.Run
    Nagare.Worker.Deploy

  build-depends:
    aeson,
    base >=4.17 && <5,
    bytestring,
    containers,
    cradle,
    crypton,
    directory,
    filepath,
    generic-lens ^>=2.2,
    http-client,
    http-client-tls,
    lens ^>=5.3,
    memory,
    nagare-dsl,
    process,
    temporary,
    text,
    time,
    vector,
    yaml,

executable nagarectl
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    bytestring,
    containers,
    directory,
    generic-lens ^>=2.2,
    lens ^>=5.3,
    nagare-dsl,
    nagarectl,
    optparse-applicative,
    text,
    time,

executable nagared
  import: common
  main-is: Main.hs
  hs-source-dirs: nagared
  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    http-types,
    nagare-dsl,
    nagarectl,
    optparse-applicative,
    text,
    wai,
    warp,

test-suite nagarectl-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
    AppDeploySpec
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    crypton,
    directory,
    filepath,
    nagare-dsl,
    nagarectl,
    tasty >=1.4,
    tasty-golden >=2.3,
    tasty-hunit >=0.10,
    temporary,
    text,
    time,
