  import: common
  main-is: Main.hs
  hs-source-dirs: nagared
  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    generic-lens ^>=2.3,
    http-types,
    lens ^>=5.3,
    nagare-dsl,
    nagarectl,
    optparse-applicative,
    text,
    wai,
    warp,

