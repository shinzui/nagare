cabal-version: 3.0
name: nagare-core
-- Constant: the release version is written only in release.json (EP-210).
version: 0.0.0
synopsis: The inventory store, recorded-state readers and lifecycle feed.
description:
  The code nagarectl and the admin API share: the inventory store and its
  recorded-state readers, the read document projections, the lifecycle
  feed and the backup collector. It embeds no release version and links no
  planner, adapter or context code, so the admin API image built from it
  changes only when this code does (MasterPlan 37).

build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wunused-packages
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Nagare.Cluster.GcsJob
    Nagare.Context.Move
    Nagare.Contract.Recorded
    Nagare.Database.AppDatabase.Backup
    Nagare.Database.AppDatabase.Sql
    Nagare.Database.Backup
    Nagare.Database.Connection
    Nagare.Database.Discover
    Nagare.Deploy.Host
    Nagare.Env.Store
    Nagare.Events.Backup
    Nagare.Events.BackupCollector
    Nagare.Events.BackupSources
    Nagare.Events.ChangeOutcome
    Nagare.Events.Delivery
    Nagare.Events.Delivery.Inspect
    Nagare.Events.Delivery.Store
    Nagare.Events.Delivery.Transport
    Nagare.Events.Envelope
    Nagare.Events.Layout
    Nagare.Events.Materialize
    Nagare.Events.Query
    Nagare.Events.Read
    Nagare.Events.Receipts
    Nagare.Events.SigningKeys
    Nagare.Events.Source
    Nagare.Events.Source.Chain
    Nagare.Events.Source.Facts
    Nagare.Events.Store
    Nagare.Events.Subscription
    Nagare.Events.Transition
    Nagare.Events.Webhook.Policy
    Nagare.Events.Webhook.Signature
    Nagare.Events.Webhook.Subscription
    Nagare.Events.Webhook.Transport
    Nagare.Inventory.AcceptedNative
    Nagare.Inventory.Access.Relationship
    Nagare.Inventory.Actor
    Nagare.Inventory.Adapter
    Nagare.Inventory.AppDatabase
    Nagare.Inventory.BackendMap
    Nagare.Inventory.Backup
    Nagare.Inventory.BackupFreshness
    Nagare.Inventory.BackupReceipt
    Nagare.Inventory.Components.Foundation
    Nagare.Inventory.DataFence
    Nagare.Inventory.Database
    Nagare.Inventory.DatabaseCredential
    Nagare.Inventory.Digest
    Nagare.Inventory.Identity
