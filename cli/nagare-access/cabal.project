-- cli/nagare-access/cabal.project
--
-- Standalone workspace for the nagare-access forward-auth enforcer. It is kept
-- separate from nagarectl so shomei/en/proxy dependencies do not enter the CLI
-- closure.
write-ghc-environment-files: always

constraints:
  time ==1.14,
  crypton >=1.1,
  crypton-x509-validation >=1.9.1,
  pg-migrate ==1.2.0.0,
  pg-migrate-cli ==1.2.0.0,
  pg-migrate-embed ==1.2.0.0,
  ephemeral-pg ==0.3.1.0

packages:
  .
  ../nagare-contract
  ../nagare-dsl

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6179d5678747aeb8ee3c45423c2bf59385dbda88
  subdir: shomei-core

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6179d5678747aeb8ee3c45423c2bf59385dbda88
  subdir: shomei-jwt

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6179d5678747aeb8ee3c45423c2bf59385dbda88
  subdir: shomei-servant

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6179d5678747aeb8ee3c45423c2bf59385dbda88
  subdir: shomei-client

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6179d5678747aeb8ee3c45423c2bf59385dbda88
  subdir: shomei-migrations

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6179d5678747aeb8ee3c45423c2bf59385dbda88
  subdir: shomei-postgres

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6179d5678747aeb8ee3c45423c2bf59385dbda88
  subdir: shomei-webauthn

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6179d5678747aeb8ee3c45423c2bf59385dbda88
  subdir: shomei-server

source-repository-package
  type: git
  location: https://github.com/shinzui/webauthn.git
  tag: c274e23a5e31aac8932bac6398b65e8bca584a99

package webauthn
  tests: False
  benchmarks: False

allow-newer:
  -- mori://shinzui/pg-migrate v1.2 changes test support only; the core, CLI,
  -- and embed APIs used by En are unchanged. Shomei requires the 1.2 cohort.
  en-migrations:pg-migrate,
  en-migrations:pg-migrate-cli,
  en-migrations:pg-migrate-embed,
  haxl:time,
  webauthn:*

source-repository-package
  type: git
  location: https://github.com/shinzui/biscuit-haskell.git
  tag: 8c0b3c5a13ce4a310737c0336f2ae167a1597588
  subdir: biscuit

source-repository-package
  type: git
  location: https://github.com/shinzui/en.git
  tag: c3ee100a0b2cc63a50a9473ef590de7086dca4d0
  subdir:
    en-core
    en-migrations
    en-postgres
    en-servant
    en-client
    en-biscuit
    en-server

-- Required by the current En server, matching its upstream project.
-- mori://shinzui/hs-opentelemetry-instrumentation-servant
source-repository-package
  type: git
  location: https://github.com/shinzui/hs-opentelemetry-instrumentation-servant.git
  tag: 7a6f692e85295f965cd1827f9354c28af9e62742
