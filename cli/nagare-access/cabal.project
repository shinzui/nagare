-- cli/nagare-access/cabal.project
--
-- Standalone workspace for the nagare-access forward-auth enforcer. It is kept
-- separate from nagarectl so shomei/en/proxy dependencies do not enter the CLI
-- closure.
write-ghc-environment-files: always

constraints:
  time ==1.14,
  crypton >=1.1,
  crypton-x509-validation >=1.9.1

packages:
  .
  ../nagare-dsl

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6a96185f4f809e5e7a99095274caa6bd90e7a8d7
  subdir: shomei-core

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6a96185f4f809e5e7a99095274caa6bd90e7a8d7
  subdir: shomei-jwt

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6a96185f4f809e5e7a99095274caa6bd90e7a8d7
  subdir: shomei-servant

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6a96185f4f809e5e7a99095274caa6bd90e7a8d7
  subdir: shomei-client

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6a96185f4f809e5e7a99095274caa6bd90e7a8d7
  subdir: shomei-migrations

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6a96185f4f809e5e7a99095274caa6bd90e7a8d7
  subdir: shomei-postgres

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6a96185f4f809e5e7a99095274caa6bd90e7a8d7
  subdir: shomei-webauthn

source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 6a96185f4f809e5e7a99095274caa6bd90e7a8d7
  subdir: shomei-server

source-repository-package
  type: git
  location: https://github.com/shinzui/webauthn.git
  tag: c274e23a5e31aac8932bac6398b65e8bca584a99

package webauthn
  tests: False
  benchmarks: False

allow-newer:
  haxl:time,
  webauthn:*

source-repository-package
  type: git
  location: https://github.com/shinzui/biscuit-haskell.git
  tag: 8c0b3c5a13ce4a310737c0336f2ae167a1597588
  subdir: biscuit

source-repository-package
  type: git
  location: https://github.com/shinzui/en.git
  tag: 054afaddfc8a1eb631373f6cdd8bfd1f1c8c9634
  subdir:
    en-core
    en-migrations
    en-postgres
    en-servant
    en-client
    en-biscuit
