cabal-version: 3.0
name: nagare-access
version: 0.1.0.0
synopsis: Shared identity-aware access enforcer for Nagare sites.
description:
  nagare-access is the shared forward-auth enforcer used by protected Nagare
  sites. It verifies shomei sessions, checks en authorization, and proxies
  authorized requests to cluster-local backends.

build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    OverloadedStrings
    PackageImports

  ghc-options:
    -Wall
    -Wno-unused-imports
    -threaded

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Nagare.Access.App
    Nagare.Access.Auth
    Nagare.Access.BackendMap
    Nagare.Access.Challenge
    Nagare.Access.Config
    Nagare.Access.Cookie
    Nagare.Access.Credential
    Nagare.Access.DecisionCache
    Nagare.Access.En
    Nagare.Access.Jwks
    Nagare.Access.Proxy
    Nagare.Access.Response
    Nagare.Access.Shomei
    Nagare.Access.ShomeiClient

  build-depends:
    aeson,
    base >=4.17 && <5,
    bytestring,
    case-insensitive,
    containers,
    crypton,
    en-client,
    en-servant,
    http-client,
    http-client-tls,
    http-types,
    jose,
    ram,
    servant-client,
    shomei-client,
    shomei-core,
    shomei-jwt,
    shomei-servant,
    text,
    wai,

executable nagare-access
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    bytestring,
    nagare-access,
    text,
    time,
    uuid,
    wai,
    warp,

test-suite nagare-access-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    base,
    aeson,
    bytestring,
    en-client,
    en-core,
    en-servant,
    effectful,
    effectful-core,
    hasql-pool,
    http-client,
    http-types,
    jose,
    nagare-access,
    network,
    servant-client,
    shomei-client,
    shomei-core,
    shomei-migrations:test-support,
    shomei-postgres,
    shomei-server,
    shomei-servant,
    tasty >=1.4,
    tasty-hunit >=0.10,
    text,
    wai,
    wai-extra,
    warp,
