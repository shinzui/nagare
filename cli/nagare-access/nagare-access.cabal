cabal-version: 3.0
name: nagare-access
-- Constant: the release version is written only in release.json (EP-210).
version: 0.0.0
synopsis: Shared identity-aware access enforcer for Nagare sites.
description:
  nagare-access is the shared forward-auth enforcer used by protected Nagare
  sites. It verifies shomei sessions, checks en authorization, and proxies
  authorized requests to cluster-local backends.

build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wno-unused-imports
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -threaded

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Nagare.Access.App
    Nagare.Access.Auth
    Nagare.Access.BackendMap
    Nagare.Access.BackendSource
    Nagare.Access.Challenge
    Nagare.Access.Config
    Nagare.Access.Cookie
    Nagare.Access.Credential
    Nagare.Access.DecisionCache
    Nagare.Access.En
    Nagare.Access.Jwks
    Nagare.Access.Portal
    Nagare.Access.Prelude
    Nagare.Access.Proxy
    Nagare.Access.RefreshCoalescer
    Nagare.Access.Response
    Nagare.Access.Shomei
    Nagare.Access.ShomeiClient

  build-depends:
    aeson,
    base >=4.17 && <5,
    bytestring,
    case-insensitive,
    containers,
    crypton,
    en-client,
    en-servant,
    generic-lens ^>=2.3,
    http-client,
    http-client-tls,
    http-types,
    jose,
    lens ^>=5.3,
    nagare-contract,
    ram,
    servant-client,
    shomei-client,
    shomei-core,
    shomei-jwt,
    shomei-servant,
    text,
    transformers,
    wai,

executable nagare-access
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    bytestring,
    generic-lens ^>=2.3,
    lens ^>=5.3,
    nagare-access,
    text,
    time,
    uuid,
    wai,
    warp,

test-suite nagare-access-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
    AdminApiGatewaySpec
    BackendMapSpec
    DecisionCacheSpec
    DelegationAccessSpec
    EdgeCacheControlSpec
    EnContractSpec
    RealShomei
    RefreshCoalescerSpec
    RememberedSessionSpec
    RotatedCookieRedirectSpec
    SessionRefreshSpec
    SiteAccessIntegrationSpec
    TeamAccessSpec
    TestServices
    WebSocketTunnelSpec

  build-depends:
    aeson,
    base,
    bytestring,
    effectful,
    effectful-core,
    en-client,
    en-core,
    en-servant,
    generic-lens ^>=2.3,
    hasql-pool,
    http-client,
    http-types,
    jose,
    lens ^>=5.3,
    nagare-access,
    nagare-contract,
    network,
    ram,
    servant-client,
    servant-health,
    shomei-client,
    shomei-core,
    shomei-jwt,
    shomei-migrations:test-support,
    shomei-postgres,
    shomei-servant,
    shomei-server,
    tasty >=1.4,
    tasty-hunit >=0.10,
    text,
    time,
    wai,
    wai-extra,
    warp,

-- The server behind `just access-browser-test` (EP-239). A test-suite so it
-- stays out of the release image's build; run without its environment variable
-- it exits at once rather than serving forever.
test-suite nagare-access-browser-harness
  import: common
  type: exitcode-stdio-1.0
  main-is: BrowserHarness.hs
  hs-source-dirs: test
  other-modules:
    RealShomei

  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    generic-lens ^>=2.3,
    hasql,
    hasql-pool,
    http-client,
    http-types,
    lens ^>=5.3,
    nagare-access,
    servant-health,
    shomei-client,
    shomei-core,
    shomei-jwt,
    shomei-migrations:test-support,
    shomei-postgres,
    shomei-servant,
    shomei-server,
    stm,
    text,
    uuid,
    wai,
    warp,
