    "operation": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/resource"
        },
        "affects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "minItems": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operationInput"
          },
          "minItems": 0
        },
        "recovery": {
          "enum": [
            "Idempotent",
            "VerifyBeforeRetry",
            "OperatorRecovery"
