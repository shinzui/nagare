                  "$ref": "#/$defs/resource"
                },
                {
                  "$ref": "#/$defs/address"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/dependency"
                  },
                  "minItems": 0
                },
                {
                  "$ref": "#/$defs/source"
                }
              ],
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "tag",
            "contents"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
