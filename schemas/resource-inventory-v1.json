        "affects",
        "inputs",
        "recovery",
        "operationKind"
      ],
      "additionalProperties": false
    },
    "contribution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "owner": {"$ref": "#/$defs/scopeId"},
            "cluster": {"$ref": "#/$defs/resource"},
            "namespace": {"$ref": "#/$defs/name"},
            "key": {"$ref": "#/$defs/name"}
          },
          "required": ["owner", "cluster", "namespace", "key"],
          "additionalProperties": false
        },
        {
